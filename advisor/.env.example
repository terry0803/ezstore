# 議價顧問 Agent 的本機開發設定（agents-cli playground / eval / scripts）。複製成 .env 後填入。
# Docker Compose（docker-compose.advisor.yml）改用專案根目錄的 .env，不讀這個檔。

# 模型憑證（二選一）
# A. Google AI Studio API key
GEMINI_API_KEY=
# B. Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

AGENT_MODEL=gemini-3.8-flash
# 改用本機 OpenAI 相容模型（例如 llama.cpp）：AGENT_MODEL 用 openai/ 開頭，再設定 API 位址
# AGENT_MODEL=openai/qwen3.5-9b
# LOCAL_LLM_BASE=http://127.0.0.1:18081/v1

# 後端 REST API（只用 GET）
BACKEND_API=http://localhost:8080/api/v1
# 報價單 Agent 的 A2A 位址；本機經前端 nginx 轉到 compose 裡的 agent
QUOTATION_AGENT_URL=http://localhost:3000/agent-api/a2a/quotation_agent
# OKF 知識庫，預設是 repo 的 knowledge/ezstore
# OKF_BUNDLE=../knowledge/ezstore
FRONTEND_URL=http://localhost:3000
