# 本機開發（agents-cli playground / eval）用的設定。複製成 .env 後填入。
# Docker Compose 會改用專案根目錄的 .env，不讀這個檔。

# 模型憑證（二選一）
# A. Google AI Studio API key
GEMINI_API_KEY=
# B. Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# 講義指定的模型。測試時為了省額度改用 gemini-3.1-flash-lite（帳號可用的模型裡最便宜的），
# 這時把 MODEL_MAX_ATTEMPTS 設成 1，429 不會自動重試。
AGENT_MODEL=gemini-3.8-flash
# AGENT_MODEL=gemini-3.1-flash-lite
# MODEL_MAX_ATTEMPTS=1
# 改用本機 OpenAI 相容模型（例如 llama.cpp）：AGENT_MODEL 用 openai/ 開頭，再設定 API 位址
# AGENT_MODEL=openai/qwen3.5-9b
# LOCAL_LLM_BASE=http://127.0.0.1:18081/v1
# 本機跑 Agent 時連 compose 對外開的 MCP 埠
MCP_URL=http://localhost:8010/mcp
FRONTEND_URL=http://localhost:3000
