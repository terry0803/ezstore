# EZStore Docker Compose 環境變數
# 複製為 .env 後填入。`.env` 已被 .gitignore 排除，不會進版本控制。

# 模型憑證（二選一）
# A. Google AI Studio API key（額度依帳號與模型）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# B. Vertex AI（需要 GCP 專案與 gcloud auth application-default login；Docker 內另需掛載 ADC 憑證）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# 講義指定的模型。測試時為了省額度改用 gemini-3.1-flash-lite（帳號可用的模型裡最便宜的），
# 這時把 MODEL_MAX_ATTEMPTS 設成 1，429 不會自動重試。
AGENT_MODEL=gemini-3.8-flash
# AGENT_MODEL=gemini-3.1-flash-lite
# MODEL_MAX_ATTEMPTS=1
# 改用本機 OpenAI 相容模型（例如 llama.cpp）時：AGENT_MODEL 用 openai/ 開頭，Agent 容器經 host.docker.internal 連到本機
# AGENT_MODEL=openai/qwen3.5-9b
# LOCAL_LLM_BASE=http://host.docker.internal:18081/v1

# 選填：前端對外網址（Agent 回覆中的系統連結）與允許的 CORS 來源
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGINS=http://localhost:3000

# 選填：MCP Server 對本機開放的埠（本機跑 agents-cli eval 時用 MCP_URL=http://localhost:8010/mcp）
MCP_HOST_PORT=8010
